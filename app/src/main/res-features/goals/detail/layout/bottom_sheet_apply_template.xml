<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B22">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="#30363D" />

        <TextView
            android:id="@+id/tv_apply_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate Study Plan"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gemini will construct your active recall quizzes and focus blocks."
            android:textColor="#8B949E"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FOCUS TOPICS"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_apply_topics"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. virtual memory, paging, thrashing"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#484F58"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="STUDY NOTES SNIPPET / FOCUS AREAS"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_apply_notes_snippet"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Specific areas of weakness or exam guidelines..."
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#484F58"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/pb_apply_template"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_apply_template"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Synthesize Tasks"
            android:textAllCaps="false"
            android:textColor="#0D0F12"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
