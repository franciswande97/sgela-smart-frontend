<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <TextView
        android:id="@+id/tv_tasks_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:text="Academic Agenda"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_tasks_count_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="#15FFFFFF"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="0 Tasks"
        android:textColor="#58A6FF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tv_tasks_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_tasks_title" />

    <TextView
        android:id="@+id/tv_tasks_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="Your scheduled focus blocks and recall challenges."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tasks_title" />

    <HorizontalScrollView
        android:id="@+id/hsv_task_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tv_tasks_subtitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textColor="#58A6FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_todo"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="To Do"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_in_progress"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="In Progress"
                android:textColor="#8B949E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_filter_completed"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_filter_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Completed"
                android:textColor="#8B949E"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/pb_tasks_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_task_filters" />

    <TextView
        android:id="@+id/tv_tasks_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No tasks found"
        android:textColor="#8B949E"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_task_filters" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_global_tasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_task_filters" />

</androidx.constraintlayout.widget.ConstraintLayout>
