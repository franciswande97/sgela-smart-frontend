<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/ll_task_detail_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_task_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_task_detail_type_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#15FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="QUIZ"
                android:textColor="#A371F7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_task_detail_state_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#15FFFFFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="TODO"
            android:textColor="#D29922"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/divider_task_detail"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#21262D"
        app:layout_constraintTop_toBottomOf="@id/ll_task_detail_header" />

    <!-- Dynamic Stage Container -->
    <FrameLayout
        android:id="@+id/fl_quiz_stage_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_task_detail" />

</androidx.constraintlayout.widget.ConstraintLayout>
